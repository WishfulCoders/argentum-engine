// Pyrokinesis
{
    "name": "Pyrokinesis",
    "manaCost": "{4}{R}{R}",
    "typeLine": "Instant",
    "oracleText": "You may exile a red card from your hand rather than pay this spell's mana cost.\nPyrokinesis deals 4 damage divided as you choose among any number of target creatures.",
    "script": {
        "spellEffect": {
            "type": "DividedDamage",
            "totalDamage": 4,
            "maxTargets": 4
        },
        "targetRequirements": [
            {
                "type": "TargetObject",
                "unlimited": true,
                "filter": {
                    "baseFilter": "creature"
                },
                "id": "t0",
                "dynamicMaxCount": {
                    "type": "Fixed",
                    "amount": 4
                }
            }
        ],
        "selfAlternativeCost": {
            "manaCost": "{0}",
            "additionalCosts": [
                {
                    "type": "AdditionalAtom",
                    "atom": {
                        "type": "AtomExileFrom",
                        "zone": "Hand",
                        "filter": "red"
                    }
                }
            ]
        }
    },
    "metadata": {
        "collectorNumber": "78",
        "rarity": "UNCOMMON",
        "artist": "Ron Spencer",
        "flavorText": "\"Anybody want some . . . *toast*?\"\n—Jaya Ballard, Task Mage",
        "imageUri": "https://cards.scryfall.io/normal/front/d/b/db2a5e85-6cbc-43c1-9362-4056ad017ef0.jpg?1783947176",
        "rulings": [
            {
                "date": "2016-06-08",
                "text": "Each target must be assigned at least 1 damage."
            },
            {
                "date": "2016-06-08",
                "text": "You divide the damage as you cast Pyrokinesis, not as it resolves. If any of the targets become illegal, damage is dealt to the other targets as originally assigned. If all targets are illegal, Pyrokinesis doesn't resolve."
            },
            {
                "date": "2016-06-08",
                "text": "If another effect causes Pyrokinesis to cost more, you must pay that additional cost even if you pay its alternative cost."
            }
        ]
    },
    "colorIdentityOverride": [
        "RED"
    ]
}

