#!/usr/bin/env bash
# Implement a whole set with headless Claude Code, one fresh session per step.
#   just set-loop <code>            e.g. just set-loop ecl
# Stop it with Ctrl-C, or `touch .claude/loop-runs/<code>.stop` to stop after the current step.
# When the subscription's usage limit is hit, it waits and retries.
set -uo pipefail

CODE=$(echo "$1" | tr '[:upper:]' '[:lower:]')
MODEL=${MODEL:-claude-opus-5-5}
REPO=$(cd "$(git rev-parse --git-common-dir)/.." && pwd)
RUNS="$REPO/.claude/loop-runs"
mkdir -p "$RUNS"

PROMPT="You are one iteration of an unattended loop implementing MTG set '$CODE' (Scryfall code).
You are a fresh session: your memory is the ledger at $RUNS/$CODE-cards.md (create it if missing)
plus GitHub. Do exactly ONE of the steps below, then stop.

Find our open PR for this set: \`gh pr list --author @me --state open --search 'agent-loop in:title'\`
and keep only one whose files touch definitions/$CODE/. Work on it in its worktree under
$REPO/.claude/worktrees/ (create one with \`git worktree add\` if missing). Never work in the main checkout.

1. PR open, CI failed -> read only the failing log tail (\`gh run view <id> --log-failed | tail -200\`),
   fix it, re-run the affected gate per the verify skill, push. A known-flaky test: \`gh run rerun --failed\` instead.
2. PR open, has merge conflicts -> rebase on origin/main (re-bless snapshot goldens instead of hand-merging), gate, push.
3. PR open, CI green, not yet reviewed (no 'loop-reviewed' comment) -> review it with the review-changes skill,
   fix what holds up, gate, push, and post a PR comment starting 'loop-reviewed' listing fixes and declines.
4. PR open, CI green, reviewed, nothing pushed since -> \`gh pr merge --squash --delete-branch\` (from $REPO, after
   \`git worktree remove\` of its worktree), mark the unit done in the ledger.
5. No PR open -> \`git fetch\`, make a new worktree + branch from origin/main. Pick up to 5 unimplemented cards
   (\`just card-status --set $CODE --list\`) that compose from existing primitives — or ONE card needing new
   engine vocabulary (add-feature skill). Skip cards the ledger marks needs-feature/needs-human. Implement each
   with the add-card skill (one scenario test file per card), gate once per the verify skill, commit, push, open a
   PR titled '[agent-loop: $MODEL] Add <N> <set name> cards' whose body lists the cards, the gate run, and
   that nothing was play-tested. Record the unit in the ledger.

If a step fails twice for the same PR, comment on it, mark it needs-human in the ledger, and move on to step 5.
Follow AGENTS.md. Never revert or stash work that isn't yours.
End your reply with exactly one line: STEP <n> DONE | SET_COMPLETE | STUCK <reason>"

# Everything the loop prints also goes to the run log.
LOGDIR="$RUNS/$CODE-logs"
mkdir -p "$LOGDIR"
exec > >(tee -a "$RUNS/$CODE.log") 2>&1
log() { echo "[$(date '+%F %T')] $*"; }

# One line per action the session takes, streamed live: its messages and each tool call.
PRETTY='select(.type == "assistant") | .message.content[]? |
  (if .type == "text" then "   💬 " + (.text | split("\n")[0] | .[0:160])
   elif .type == "tool_use" then "   → " + .name + ": " +
     ((.input.description // .input.command // .input.skill // .input.file_path // .input.pattern
       // .input.prompt // "") | tostring | split("\n")[0] | .[0:140])
   else empty end)'

log "set-loop $CODE started (model $MODEL, log $RUNS/$CODE.log)"
N=0
while [ ! -e "$RUNS/$CODE.stop" ]; do
  N=$((N + 1))
  # Wait on CI for free instead of spending a session on it.
  PR=$(gh pr list --author @me --state open --search 'agent-loop in:title' --json number,files \
        --jq "[.[] | select([.files[].path] | any(test(\"definitions/$CODE/\")))][0].number // empty")
  if [ -n "$PR" ]; then
    log "waiting for CI on PR #$PR"
    sleep 60
    gh pr checks "$PR" --watch >/dev/null 2>&1
    log "CI on PR #$PR: $(gh pr checks "$PR" --json bucket --jq '[.[].bucket] | group_by(.) | map("\(.[0])=\(length)") | join(" ")' 2>/dev/null)"
  fi

  TRANSCRIPT="$LOGDIR/$(date '+%Y%m%d-%H%M%S')-iter$N.jsonl"
  log "iteration $N (PR: ${PR:-none}) — transcript $TRANSCRIPT"
  (cd "$REPO" && claude -p "$PROMPT" --model "$MODEL" --permission-mode "${PERMISSION_MODE:-auto}" \
      --output-format stream-json --verbose 2>&1) \
    | tee "$TRANSCRIPT" | jq -Rr --unbuffered "fromjson? | $PRETTY"

  FINAL=$(jq -Rc 'fromjson? | select(.type == "result")' "$TRANSCRIPT" 2>/dev/null | tail -1)
  RESULT=$(echo "$FINAL" | jq -r '.result // empty' 2>/dev/null)
  LAST=$(echo "$RESULT" | tail -1)
  log "iteration $N finished: ${LAST:-<no result>} ($(echo "$FINAL" | jq -r '"\(.num_turns // "?") turns, \((.duration_ms // 0) / 60000 | floor) min"' 2>/dev/null))"

  if [ -z "$FINAL" ] || grep -qiE 'usage limit|hit your limit|rate limit|overloaded' <<<"$RESULT$(tail -5 "$TRANSCRIPT")"; then
    log "no result or limit reached — waiting 30 min"; sleep 1800; continue
  fi
  case $LAST in
    SET_COMPLETE*) log "set $CODE complete"; exit 0 ;;
    STUCK*)        log "stuck — see the ledger at $RUNS/$CODE-cards.md"; exit 1 ;;
  esac
done
log "stop file found — stopping"
rm -f "$RUNS/$CODE.stop"
